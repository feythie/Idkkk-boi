<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Special Question</title>
<style>
body {
    background-color: #E6D8FF;
    font-family: "Brush Script MT", cursive;
    text-align: center;
    padding-top: 80px;
}h1 { color: #5A2D82; font-size: 36px; }

button { background-color: #5A2D82; color: white; border: none; padding: 15px 30px; margin: 10px; font-size: 20px; cursor: pointer; border-radius: 10px; font-family: "Brush Script MT", cursive; }

#message { margin-top: 30px; font-size: 22px; color: #4B1F6F; }

.confetti { position: fixed; top: 0; width: 10px; height: 10px; background-color: purple; animation: fall 3s linear infinite; }

@keyframes fall { 0% { transform: translateY(0); } 100% { transform: translateY(100vh); } } </style>

</head>
<body><h1>ZEE WANTS YOUR HAND IN MARRIAGE. WILL YOU ACCEPT?</h1><button onclick="yesClick()">YES</button> <button onclick="noClick()">NO</button>

<div id="message"></div><script>
function noClick() {
    document.getElementById("message").innerHTML = "THAT IS NOT AN OPTION";
}

function yesClick() {
    document.getElementById("message").innerHTML = "CONGRATULATIONS YOU ARE OFFICIALLY MARRIED TODAY! THIS IS A BEAUTIFUL MOMENT IN HISTORY WHERE TWO AMAZING PEOPLE HAVE COME TOGETHER IN LOVE AND HAPPINESS. MAY YOUR DAYS BE FILLED WITH LAUGHTER, JOY, AND LOTS OF FUN ADVENTURES FOREVER AND EVER!";
    startConfetti();
}

function startConfetti() {
    for (let i = 0; i < 100; i++) {
        let confetti = document.createElement("div");
        confetti.className = "confetti";
        confetti.style.left = Math.random() * 100 + "vw";
        confetti.style.animationDuration = (Math.random() * 3 + 2) + "s";
        confetti.style.backgroundColor = getRandomColor();
        document.body.appendChild(confetti);

        setTimeout(() => {
            confetti.remove();
        }, 5000);
    }
}

function getRandomColor() {
    const colors = ["#5A2D82", "#9B59B6", "#D7BDE2", "#8E44AD", "#C39BD3"];
    return colors[Math.floor(Math.random() * colors.length)];
}
</script></body>
</html>
